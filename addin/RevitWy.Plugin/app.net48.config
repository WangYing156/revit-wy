<?xml version="1.0" encoding="utf-8"?>
<!--
  Revit 2022–2024 插件运行时的 Newtonsoft.Json 绑定重定向。

  「为什么需要它」：
  Revit 进程里已经有一份 Newtonsoft.Json（12.x）。插件如果引用 13.x，
  在某些加载顺序下会报
      Could not load file or assembly 'Newtonsoft.Json, Version=13.0.0.0'
  把 13.x 重定向到 12.0.0.0，可以让两者共存，且不用去动 Revit 自己的配置。

  注意：这份文件必须和 RevitWy.Plugin.dll 放在同一目录，文件名必须是
  「程序集名.dll.config」。构建时通过 csproj 的 Link 重命名成
  RevitWy.Plugin.dll.config。
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
