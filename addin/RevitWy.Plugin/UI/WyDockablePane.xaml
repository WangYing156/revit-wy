<!--
  revit-wy 停靠面板（纯 WPF，无 WebView2）

  为什么不在这里用 WebView2：
    Revit 2022 已内嵌 WebView2（自带运行时），理论上可用，但实测风险高：
      · 关闭 Revit 时易抛 "CoreWebView2 members cannot be accessed after disposed"
      · 从网页回调里调用 doc.LoadFamily() 会让 WebView2 卡死且无法恢复
      · 与 Revit 渲染的"空域（airspace）"问题导致控件偶发空白
    而本面板的全部需求（列图层、改下拉、画预览）纯 WPF 就能做到，
    没必要为了"网页好看"引入一个不可控的崩溃源。

  UserControl 而非 Page：DockablePane 对 UserControl 的支持更稳，
  且不需要 NavigationService 生命周期。
-->
<UserControl x:Class="RevitWy.Plugin.UI.WyDockablePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitWy.Plugin.UI"
             Background="#1A1F27" Foreground="#E4E8EF" FontSize="12"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#222834"/>
        <SolidColorBrush x:Key="Line" Color="#2F3745"/>
        <SolidColorBrush x:Key="Dim" Color="#8B95A5"/>
        <SolidColorBrush x:Key="Accent" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="Ok" Color="#3ECF8E"/>
        <SolidColorBrush x:Key="Warn" Color="#F5A623"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#222834"/>
            <Setter Property="Foreground" Value="#E4E8EF"/>
            <Setter Property="BorderBrush" Value="#2F3745"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4DA3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#4DA3FF"/>
            <Setter Property="Foreground" Value="#08121E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RightAlign" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#8B95A5"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E8EF"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 状态条 -->
            <RowDefinition Height="Auto"/>   <!-- 操作区 -->
            <RowDefinition Height="*"/>      <!-- 图层列表 -->
            <RowDefinition Height="Auto"/>   <!-- 底部 -->
        </Grid.RowDefinitions>

        <!-- ================= 状态条 ================= -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{StaticResource Dim}" VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="未连接 MCP 服务"
                               Foreground="{StaticResource Dim}" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="DocText" Text="文档：—" Margin="14,3,0,0"
                           Foreground="{StaticResource Dim}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- ================= 操作区 ================= -->
        <StackPanel Grid.Row="1" Margin="10,10,10,6">
            <TextBlock Text="数模对照 · 图层归属" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock Text="双击行可快速切换 建模/隔离。改完点「应用到 Revit」下发。"
                       Foreground="{StaticResource Dim}" FontSize="10"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <UniformGrid Columns="3" Margin="0,0,0,6">
                <Button x:Name="BtnRefresh" Content="刷新图层" Style="{StaticResource Btn}"
                        Margin="0,0,4,0" Click="OnRefresh"/>
                <Button x:Name="BtnPreview" Content="预览高亮" Style="{StaticResource Btn}"
                        Margin="0,0,4,0" Click="OnPreview" IsEnabled="False"/>
                <Button x:Name="BtnApply" Content="应用到 Revit" Style="{StaticResource PrimaryBtn}"
                        Margin="0" Click="OnApply" IsEnabled="False"/>
            </UniformGrid>

            <Button x:Name="BtnClear" Content="清理上次翻模的构件"
                    Style="{StaticResource Btn}" HorizontalAlignment="Left"
                    Margin="0,2,0,0" Click="OnClear"/>
        </StackPanel>

        <!-- ================= 图层列表 ================= -->
        <Border Grid.Row="2" Margin="10,0,10,6" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Background="#161B22">
            <DataGrid x:Name="LayerGrid" AutoGenerateColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#1A1F27"
                      Foreground="#E4E8EF" FontSize="11"
                      CanUserAddRows="False" CanUserResizeRows="False"
                      SelectionMode="Single" RowHeight="26"
                      HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#222834"/>
                        <Setter Property="Foreground" Value="#8B95A5"/>
                        <Setter Property="Padding" Value="6,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="18">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Fill="{Binding ActionBrush}"
                                         VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="图层名" Binding="{Binding LayerName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding LayerName}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="实体" Binding="{Binding Count}" Width="42"
                                        ElementStyle="{StaticResource RightAlign}"/>

                    <DataGridTemplateColumn Header="归属" Width="86">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static local:WyDockablePane.ComponentOptions}"
                                          SelectedItem="{Binding Component, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="10" Padding="2,0" Height="20"
                                          Background="#222834" Foreground="#E4E8EF"
                                          BorderBrush="#2F3745"
                                          SelectionChanged="OnComponentChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="置信" Binding="{Binding Confidence}" Width="42"
                                        ElementStyle="{StaticResource RightAlign}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= 底部 ================= -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="10,7">
            <StackPanel>
                <TextBlock x:Name="SummaryText" Text="—" Foreground="{StaticResource Dim}"
                           FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="HintText"
                           Text="提示：先在 Cursor/WorkBuddy 里跑 rwy_review_mapping 生成对照单，这里再逐条确认。"
                           Foreground="#5A6474" FontSize="10" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
