<?xml version="1.0" encoding="utf-8"?>
<!--
  RevitWy.Plugin 构建配置 —— 单代码库，多 Revit 版本

  支持 Revit 2022 及以上。版本与运行时的对应关系（Autodesk 官方口径）：

      Revit 2022 – 2024  →  net48            （.NET Framework 4.8）
      Revit 2025 – 2026  →  net8.0-windows   （.NET 8）
      Revit 2027+        →  net10.0-windows   （.NET 10，预留）

  用法
  ====
  默认按本机最高版本编译：

      dotnet build addin/RevitWy.Plugin -c Release

  指定版本（一次一个，或脚本里循环）：

      dotnet build addin/RevitWy.Plugin -c Release -p:RevitVersion=2024
      dotnet build addin/RevitWy.Plugin -c Release -p:RevitVersion=2025

  不想装 Revit 也能编译（走 NuGet 的 API 包，CI 用）：

      dotnet build addin/RevitWy.Plugin -p:UseNugetRevitApi=true -p:RevitVersion=2025

  为什么不做成一次 build 内 Multi-Target
  ===================================
  每个 Revit 版本的 API 程序集不同，且 .addin 清单要指向该版本自己的 DLL，
  混在一个 bin 目录里极易装错（装错的后果是 Revit 静默跳过，连报错都没有）。
  所以这里用"一个版本一次编译、各自独立输出目录"的方式，由
  scripts/build-addin.ps1 统一编排，安装时再按版本部署。
  这比 MSBuild 的 Multi-Target 啰嗦，但能保证"哪个 DLL 属于哪个 Revit"永远清楚。
-->

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    为什么要忽略工作负载解析（MSB3644 的根因）
    ==========================================
    net48 目标需要 .NET Framework 4.8 的**引用程序集**（Targeting Pack）。
    经典的报错是：

        error MSB3644: 找不到 .NETFramework,Version=v4.8 的引用程序集。
        请为此框架版本安装开发人员工具包(SDK/目标包)或者重新定向应用程序。

    在装了很多版本 SDK 的机器上（比如同时有 8/9/10），
    `dotnet build` 会去解析"某个 SDK 工作负载能提供 net48"，
    一旦解析不到就当成缺 TargetFramework，于是转向 Targeting Pack 并抛 MSB3644，
    哪怕 C:\Program Files (x86)\Reference Assemblies\...\v4.8 明明存在。

    这里显式声明"net48 由 CodeDom 提供程序负责"，跳过工作负载解析，
    让 MSBuild 直接使用已有的引用程序集。
  -->
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 目标 Revit 版本。可被 -p:RevitVersion=20xx 覆盖。 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>

    <!--
      按 RevitVersion 决定 TargetFramework 与编译符号。
      规则来自 Autodesk 的 Development Requirements：
        2022–2024 → net48；2025–2026 → net8.0-windows；2027+ → net10.0-windows
    -->
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt; '2026'">net10.0-windows</TargetFramework>

    <!-- 版本符号，供 Compat.cs 与业务代码做 #if 分支 -->
    <DefineConstants>$(DefineConstants);REVIT_$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2023'">$(DefineConstants);REVIT_2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2024'">$(DefineConstants);REVIT_2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2025'">$(DefineConstants);REVIT_2025_OR_GREATER;REVIT_NET8_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2027'">$(DefineConstants);REVIT_2027_OR_GREATER</DefineConstants>

    <LangVersion>latest</LangVersion>
    <AssemblyName>RevitWy.Plugin</AssemblyName>
    <RootNamespace>RevitWy.Plugin</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>revit-wy</Company>
    <Product>revit-wy 一键翻模</Product>
    <Version>0.2.0</Version>
    <NoWarn>MSB3277</NoWarn>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 每个 Revit 版本独立输出目录，避免装错 DLL -->
    <BaseOutputPath>bin\$(RevitVersion)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\$(RevitVersion)\</BaseIntermediateOutputPath>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitApiDir>
  </PropertyGroup>

  <!-- ============================ API 引用 ============================ -->
  <PropertyGroup Condition="'$(UseNugetRevitApi)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_NUGET_API</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNugetRevitApi)' == 'true'">
    <!-- Nice3point 的 API 包按 Revit 版本分发，版本号跟着 RevitVersion 走 -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNugetRevitApi)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- ============================ 依赖 ============================ -->
  <ItemGroup>
    <!--
      Newtonsoft.Json 版本必须**不高于** Revit 自带的版本，否则运行时会崩
      ================================================================
      Revit 2022–2024 自带的 Newtonsoft.Json 版本线是 12.x。插件引用 13.x 时，
      如果 13.x 的 DLL 没被正确加载，就会报经典的

          Could not load file or assembly 'Newtonsoft.Json, Version=13.0.0.0'

      ——本工程第一版就在 ListTypes 上踩过这个，表现为"插件加载了但一调就报错"。
      net48 下固定用 12.0.3（插件自带的 12.0.3 能和 Revit 的 12.x 互相顶替）。
      net8.0-windows 下 Revit 2025+ 的依赖解析走 .NET 8 的统一算法，13.x 可用。
    -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3"
                      Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"
                      Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RevitWy.Plugin.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    net48 的 app.config 绑定重定向
    ==============================
    Revit 宿主进程的 app.config 我们改不了，但 assembly resolve 会同时看插件目录下的
    RevitWy.Plugin.dll.config。把 Newtonsoft 重定向到 12.0.0.0，能让"某个传递依赖
    仍然引用 13.x"的情况也能加载成功。
    这一项在 net8.0-windows 下无意义，所以只在 net48 生成。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <None Include="app.net48.config" Condition="Exists('app.net48.config')">
      <Link>RevitWy.Plugin.dll.config</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    net48 前置检查：MSB3644 时给出能直接照做的一句话
    ================================================
    MSBuild 的原生报错是英文 + 一堆链接，用户看不懂该装什么。这里在编译前
    自己检查引用程序集，缺了就直接抛出中文指令，并明确"最小代价的三条路"。
  -->
  <Target Name="CheckNet48ReferenceAssemblies" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(TargetFramework)' == 'net48'">
    <PropertyGroup>
      <_RwyFwRefDir Condition="'$(OS)' == 'Windows_NT'">$(ProgramFiles(x86))\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8</_RwyFwRefDir>
    </PropertyGroup>
    <Warning Text="找不到 .NET Framework 4.8 引用程序集：$(_RwyFwRefDir)。三选一：(1) 用 -UseNuget 编译（不需要 .NET Framework 开发包，推荐）；(2) 装 .NET Framework 4.8 Developer Pack；(3) 装 Visual Studio / Build Tools 并勾选 .NET Framework 4.8 targeting pack。"
             Condition="!Exists('$(_RwyFwRefDir)\mscorlib.dll')" />
  </Target>

  <!-- ============================ 部署 ============================ -->
  <!-- 部署到 %APPDATA%\Autodesk\Revit\Addins\<版本> -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true'">
    <PropertyGroup>
      <RevitAddinDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinDir>
      <DeployDir>$(RevitAddinDir)\revit-wy</DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)Newtonsoft.Json.dll" DestinationFolder="$(DeployDir)"
          Condition="Exists('$(TargetDir)Newtonsoft.Json.dll')" />
    <Copy SourceFiles="$(TargetDir)RevitWy.Plugin.dll.config" DestinationFolder="$(DeployDir)"
          Condition="Exists('$(TargetDir)RevitWy.Plugin.dll.config')" />
    <Copy SourceFiles="$(ProjectDir)config.json" DestinationFolder="$(DeployDir)"
          Condition="Exists('$(ProjectDir)config.json')" />
    <Copy SourceFiles="$(ProjectDir)RevitWy.Plugin.addin" DestinationFolder="$(RevitAddinDir)" />
    <Message Text="revit-wy 已部署到 $(RevitAddinDir)（Revit $(RevitVersion)）" Importance="high" />
  </Target>

</Project>
